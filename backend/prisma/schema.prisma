generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["pc"]
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           UserRole       @default(USER)
  plan           Plan           @default(FREE)
  planExpiresAt  DateTime?
  streakDays     Int            @default(0)
  lastActiveAt   DateTime       @default(now())
  diagnosticDone Boolean        @default(false)
  readinessScore Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  emailVerified    Boolean   @default(false)
  verifyToken      String?
  verifyTokenExpiry DateTime?
  xpPoints       Int            @default(0)
  attempts       Attempt[]
  certifications EmployeeCertification[]
  customTests    CustomTest[]
  completions    ModuleCompletion[]
  competencyRoles CompetencyRole[]
  gapAnalyses    GapAnalysisRecord[]
  bookmarks      Bookmark[]
  notifications  Notification[]
  studyPlans     StudyPlan?

  @@map("users")
  @@schema("pc")
}

model Category {
  id             String         @id @default(cuid())
  name           String         @unique
  slug           String         @unique
  description    String
  icon           String         @default("📊")
  color          String         @default("#0A528A")
  assessmentType AssessmentType @default(APTITUDE)
  examType       ExamType?
  targetLevels   String[]       @default([])
  isStudentOnly  Boolean        @default(false)
  targetRoles    String[]       @default([]) // e.g. ["accountant","nurse","engineer"]
  isFreeTrialOnly Boolean       @default(false)
  trialDurationMin Int          @default(30)
  questions      Question[]

  @@map("categories")
  @@schema("pc")
}

model Question {
  id             String       @id @default(cuid())
  categoryId     String
  subSkill       String
  text           String
  imageUrl       String?
  caseStudyId    String?
  diagramData    Json?        // { type: "pie"|"bar"|"line"|"table"|"passage", data: {...} }
  options        Json
  explanation    String
  difficulty     Int          @default(3)
  discrimination Float        @default(1.0)
  timeLimit      Int          @default(60)
  tags           String[]
  isActive       Boolean      @default(true)
  flagCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  attempts       Attempt[]
  bookmarks      Bookmark[]
  category       Category     @relation(fields: [categoryId], references: [id])

  @@map("questions")
  @@schema("pc")
}

model Attempt {
  id             String      @id @default(cuid())
  userId         String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  timeTaken      Int
  confidence     Int?
  sessionId      String?
  mode           AttemptMode @default(PRACTICE)
  createdAt      DateTime    @default(now())
  question       Question    @relation(fields: [questionId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  @@map("attempts")
  @@schema("pc")
}

model MockExam {
  id          String    @id @default(cuid())
  userId      String
  title       String
  categoryIds String[]
  totalQ      Int
  score       Float?
  percentile  Float?
  duration    Int
  completedAt DateTime?
  answers     Json
  createdAt   DateTime  @default(now())

  @@map("mock_exams")
  @@schema("pc")
}

model StudyPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("study_plans")
  @@schema("pc")
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  note       String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
  @@map("bookmarks")
  @@schema("pc")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@schema("pc")
}

enum UserRole {
  USER
  ADMIN
  CONTENT_MANAGER
  SUPER_ADMIN

  @@schema("pc")
}

enum Plan {
  FREE
  TRIAL
  PREMIUM
  ENTERPRISE
  STUDENT
  WEEK
  MONTH
  YEAR

  @@schema("pc")
}

enum AssessmentType {
  APTITUDE          // General psychometric
  EXAM_PREP         // IELTS / TOEFL / OET etc
  GRADUATE          // Graduate-level
  PROFESSIONAL      // Work-experience based
  TECHNICAL         // Role-specific technical
  PERSONALITY       // Personality / behavioural

  @@schema("pc")
}

enum ExamType {
  IELTS
  TOEFL
  OET
  GRE
  GMAT
  SAT
  USMLE

  @@schema("pc")
}

enum AttemptMode {
  DIAGNOSTIC
  PRACTICE
  TIMED
  MOCK
  REVIEW

  @@schema("pc")
}

// ── Advertising ──────────────────────────────────────────────────────────────

model Advertiser {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  email        String   @unique
  phone        String?
  website      String?
  passwordHash String
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ads          Ad[]
  payments     AdPayment[]

  @@map("advertisers")
  @@schema("pc")
}

model Ad {
  id           String    @id @default(cuid())
  advertiserId String
  title        String
  headline     String
  bodyText     String
  ctaText      String    @default("Learn More")
  ctaUrl       String
  imageUrl     String?
  slot         AdSlot    @default(BANNER)
  status       AdStatus  @default(PENDING)
  budget       Float     // ZMW
  spent        Float     @default(0)
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  targetPages  String[]  @default([])
  rejectedNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id])
  payments     AdPayment[]
  events       AdEvent[]

  @@map("ads")
  @@schema("pc")
}

model AdPayment {
  id           String        @id @default(cuid())
  advertiserId String
  adId         String?
  amount       Float
  currency     String        @default("USD")
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String?
  status       PaymentStatus @default(PENDING)
  notes        String?
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
  advertiser   Advertiser    @relation(fields: [advertiserId], references: [id])
  ad           Ad?           @relation(fields: [adId], references: [id])

  @@map("ad_payments")
  @@schema("pc")
}

model AdEvent {
  id        String     @id @default(cuid())
  adId      String
  type      AdEventType
  page      String?
  userAgent String?
  ip        String?
  createdAt DateTime   @default(now())
  ad        Ad         @relation(fields: [adId], references: [id])

  @@map("ad_events")
  @@schema("pc")
}

enum AdSlot {
  BANNER        // top of page, full width
  SIDEBAR       // right sidebar on desktop
  IN_FEED       // between questions/content
  FOOTER_BANNER // bottom of page

  @@schema("pc")
}

enum AdStatus {
  PENDING   // awaiting admin review
  APPROVED  // live
  REJECTED  // declined
  PAUSED    // paused by advertiser or admin
  COMPLETED // budget exhausted or end date passed
  DRAFT     // not yet submitted

  @@schema("pc")
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CARD

  @@schema("pc")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED

  @@schema("pc")
}

enum AdEventType {
  IMPRESSION
  CLICK

  @@schema("pc")
}

// ═══ Virtual Interview Panelist (SRS 2026-08) ═══════════════════════════════
model InterviewQuestion {
  id              String   @id @default(cuid())
  archetype       String   // TECH_LEAD | HR_MANAGER | PRODUCT_MANAGER | EXEC_DIRECTOR
  jobFamily       String   // e.g. Software Engineering, Sales, Finance, General
  tier            String   @default("Mid")  // Junior | Mid | Senior | Executive
  difficulty      Int      @default(2)      // 1-5
  questionText    String
  expectedKeywords String? // comma-separated keyword matrix for semantic scoring
  followUp        String?
  createdAt       DateTime @default(now())

  @@index([archetype, jobFamily, tier])
  @@schema("pc")
}

model InterviewSession {
  id             String   @id @default(cuid())
  userId         String
  jobFamily      String
  tier           String
  status         String   @default("in_progress") // in_progress | completed
  currentRound   Int      @default(1)             // 1-4
  currentTurn    Int      @default(0)             // 0-16
  aggregateScore Float?
  technicalAvg   Float?
  structuralAvg  Float?
  fluencyAvg     Float?
  growthDelta    Float?
  summary        String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  responses      InterviewResponse[]

  @@index([userId])
  @@schema("pc")
}

model InterviewResponse {
  id             String   @id @default(cuid())
  sessionId      String
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round          Int
  turn           Int
  archetype      String
  questionText   String
  transcript     String   // user's answer
  technicalScore Float    @default(0)
  structuralScore Float   @default(0)  // STAR compliance
  fluencyScore   Float    @default(0)
  starSituation  Boolean  @default(false)
  starTask       Boolean  @default(false)
  starAction     Boolean  @default(false)
  starResult     Boolean  @default(false)
  feedback       String?
  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@schema("pc")
}

model UserPayment {
  id            String   @id @default(cuid())
  userId        String
  plan          Plan
  amount        Float
  currency      String   @default("USD")
  provider      String
  providerRef   String?
  status        String   @default("pending")
  planStartsAt  DateTime @default(now())
  planExpiresAt DateTime
  createdAt     DateTime @default(now())
  amountZmw     Float?
  operator      String?
  phone         String?
  referenceNo   String?  @unique
  transactionId String?
  @@map("user_payments")
  @@schema("pc")
}

// ── SRS: B2C Digital Passports (prep manuals w/ single-use 72h signed URLs) ──
model DigitalPassport {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  provider    String              // e.g. SHL, Korn Ferry, Predictive Index
  description String
  priceUsd    Float
  fileUrl     String              // source manual (server-only)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  purchases   PassportPurchase[]
  @@map("digital_passports")
  @@schema("pc")
}

model PassportPurchase {
  id           String          @id @default(cuid())
  passportId   String
  passport     DigitalPassport @relation(fields: [passportId], references: [id])
  userId       String?
  email        String
  amount       Float
  currency     String          @default("USD")
  provider     String          @default("zynlepay")
  providerRef  String?
  status       String          @default("paid")
  signedToken  String          @unique
  tokenExpiry  DateTime        // 72h from issuance
  downloadedAt DateTime?       // single-use: set on first download
  createdAt    DateTime        @default(now())
  @@index([signedToken])
  @@map("passport_purchases")
  @@schema("pc")
}

// ── SRS: Human-in-the-loop audit tickets (order-bump add-on) ──
model AuditTicket {
  id             String   @id @default(cuid())
  userId         String?
  email          String
  sessionId      String?  // linked interview session
  recordingRef   String?
  transcript     String?
  analytics      Json?
  status         String   @default("open") // open | in_review | delivered
  reviewerNotes  String?
  adjustments    Json?    // 3-point behavioural adjustment list
  correlationId  String?
  createdAt      DateTime @default(now())
  deliveredAt    DateTime?
  @@index([status])
  @@map("audit_tickets")
  @@schema("pc")
}

// ── SRS: AI Resume-to-Interview Matcher funnel ──
model ResumeMatch {
  id            String   @id @default(cuid())
  email         String?  // captured at gate
  gateSatisfied Boolean  @default(false)
  jobDescription String
  matchScore    Int      @default(0)
  hardSkills    Json?
  softSkills    Json?
  gaps          Json?
  jobFamily     String?
  tier          String?
  sessionId     String?  // resulting paid VIA session
  createdAt     DateTime @default(now())
  @@map("resume_matches")
  @@schema("pc")
}

// ── SRS: B2B Secure Enterprise Screening ──
model Assessment {
  id            String                @id @default(cuid())
  recruiterId   String?
  recruiterEmail String
  candidateEmail String
  candidateToken String               @unique
  role          String
  difficulty    String                @default("Mid")
  jobFamily     String                @default("General")
  status        String                @default("pending") // pending | in_progress | completed
  seed          String                // for Fisher-Yates uniqueness
  readingSec    Int                   @default(30)
  speakingSec   Int                   @default(120)
  createdAt     DateTime              @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  questions     AssessmentQuestion[]
  violations    ViolationLog[]
  @@index([candidateToken])
  @@map("assessments")
  @@schema("pc")
}

model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  ordinal      Int
  questionText String
  answer       String?
  answeredAt   DateTime?
  @@index([assessmentId])
  @@map("assessment_questions")
  @@schema("pc")
}

model ViolationLog {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  type         String     // MULTI_FACE | FACE_ABSENT | GAZE_DIVERSION | FULLSCREEN_EXIT | CURSOR_ESCAPE | VISIBILITY | CLIPBOARD
  detail       String?
  correlationId String?
  createdAt    DateTime   @default(now())
  @@index([assessmentId])
  @@map("violation_logs")
  @@schema("pc")
}

// ════════ SRS ADDENDUM (2026-09): enterprise tier, certifications, localization ════════

enum BadgeTier {
  NONE
  GOLD
  PLATINUM

  @@schema("pc")
}

enum DiscountType {
  PERCENTAGE
  FLAT_FIXED

  @@schema("pc")
}

model Enterprise {
  id                  String    @id @default(cuid())
  name                String
  ownerEmail          String
  dodoSubscriptionId  String?   @unique
  trialStartedAt      DateTime?
  trialDays           Int       @default(30)
  isTrialActive       Boolean   @default(false)
  isPaidSubscriber    Boolean   @default(false)
  reports             MonthlyReport[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("enterprises")
  @@schema("pc")
}

model Coupon {
  couponCode            String       @id
  discountType          DiscountType
  discountValue         Decimal      @db.Decimal(10, 2)
  dodoPriceOverrideId   String?
  expiresAt             DateTime?
  usageLimit            Int?
  usedCount             Int          @default(0)
  createdAt             DateTime     @default(now())

  @@map("coupons")
  @@schema("pc")
}

model EmployeeCertification {
  certificationId String   @id @default(uuid())
  employeeId      String
  employee        User     @relation(fields: [employeeId], references: [id])
  courseId        String
  examScore       Decimal  @db.Decimal(5, 2)
  badgeTier       BadgeTier @default(NONE)
  certifiedAt     DateTime @default(now())

  @@unique([employeeId, courseId], name: "unique_employee_course_cert")
  @@map("employee_certifications")
  @@schema("pc")
}

model LocalizationAsset {
  id         String @id @default(cuid())
  region     String // e.g. "ZM", "US", "UK", "GLOBAL"
  token      String // e.g. "LocalName1", "LocalCompany1", "LocalCurrency"
  value      String // e.g. "Chansa", "Mwansa Ltd", "K"
  createdAt  DateTime @default(now())

  @@unique([region, token])
  @@map("localization_assets")
  @@schema("pc")
}


// ── SRS FR-1: Test Architect (custom test assembly + candidate links) ──
model CustomTest {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  createdBy   String
  creator     User       @relation(fields: [createdBy], references: [id])
  questionIds String[]
  isPublic    Boolean    @default(true)
  linkToken   String     @unique
  links       TestLink[]
  createdAt   DateTime   @default(now())

  @@map("custom_tests")
  @@schema("pc")
}

model TestLink {
  id             String     @id @default(cuid())
  token          String     @unique
  testId         String
  test           CustomTest @relation(fields: [testId], references: [id])
  candidateEmail String
  candidateName  String?
  responses      Json?
  usedCount      Int        @default(0)
  submittedAt    DateTime?
  inviteSentAt   DateTime?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())

  @@map("test_links")
  @@schema("pc")
}

// ── SRS FR-8.2: auto-compiled Monthly Status Reports ──
model MonthlyReport {
  id           String   @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  month        String // "2026-09"
  data         Json
  emailedAt    DateTime?
  createdAt    DateTime @default(now())

  @@unique([enterpriseId, month])
  @@map("monthly_reports")
  @@schema("pc")
}

// ── SRS FR-6: CMS Studio — persistent media assets + rich case studies ──
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  sizeBytes Int
  width     Int?
  height    Int?
  data      String // base64 payload (DB-backed: survives redeploys)
  uploadedBy String
  createdAt DateTime @default(now())

  @@map("media_assets")
  @@schema("pc")
}

model CaseStudy {
  id        String   @id @default(cuid())
  title     String
  bodyHtml  String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("case_studies")
  @@schema("pc")
}

// ── SRS FR-5: AI Training Bank & Micro-Learning Recommendation Core ──
model LearningModule {
  id         String   @id @default(cuid())
  title      String
  format     String   @default("READ") // READ | COURSE | DRILL
  contentHtml String
  estMinutes Int      @default(5) // AI-calculated reading duration (FR-5.2)
  tags       String[] // gap skills this module fixes (FR-5.1/5.4)
  isActive   Boolean  @default(true)
  completions ModuleCompletion[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("learning_modules")
  @@schema("pc")
}

model ModuleCompletion {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  moduleId  String
  module    LearningModule @relation(fields: [moduleId], references: [id])
  completedAt DateTime     @default(now())

  @@unique([userId, moduleId])
  @@map("module_completions")
  @@schema("pc")
}

// ── SRS FR-3: competency frameworks + machine-readable gap analysis ──
model CompetencyRole {
  id           String  @id @default(cuid())
  name         String
  baselines    Json // { "Numerical Reasoning": 70, ... } — min % per skill
  createdBy    String
  creator      User    @relation(fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())

  @@map("competency_roles")
  @@schema("pc")
}

model GapAnalysisRecord {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  roleTitle      String
  scores         Json // { skill: accuracyPct }
  gaps           Json // [skills below baseline]
  belowThreshold Boolean
  createdAt      DateTime       @default(now())

  @@map("gap_analysis_records")
  @@schema("pc")
}

// ── SRS FR-9.1: base price management (singleton row) ──
model PlatformPricing {
  id                    String   @id @default("singleton")
  enterpriseMonthlyUsd  Decimal  @db.Decimal(10, 2) @default(29.00)
  candidateLinkUsd      Decimal  @db.Decimal(10, 2) @default(4.00)
  updatedBy             String?
  updatedAt             DateTime @updatedAt

  @@map("platform_pricing")
  @@schema("pc")
}

// ── SRS FR-9.3: system-wide promotional banners ──
model PromoBanner {
  id        String    @id @default(cuid())
  message   String
  ctaText   String    @default("")
  ctaUrl    String    @default("")
  audience  String    @default("ALL") // ALL | TRIAL
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())

  @@map("promo_banners")
  @@schema("pc")
}

// ════════════════════════════════════════════════════════════════════════════
// ENTERPRISE BLUEPRINT v4.0 — B2B Workforce Assessment Ecosystem
// (100-Q adaptive sim, passive telemetry, corporate reports, certificates)
// ════════════════════════════════════════════════════════════════════════════

model EnterpriseOrg {
  id           String              @id @default(cuid())
  companyName  String
  ownerEmail   String
  licenseTier  String              @default("Enterprise Premium")
  createdAt    DateTime            @default(now())
  sessions     CandidateSession[]
  reports      CorporateTalentReport[]

  @@map("enterprise_orgs")
  @@schema("pc")
}

model CandidateSession {
  id                   String                  @id @default(cuid())
  orgId                String
  org                  EnterpriseOrg           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  candidateName        String                  @default("")
  candidateEmail       String                  @default("")
  targetDepartment     String
  targetTier           String                  // Operations | Mid Management | Senior Management | Executive
  industryField        String                  @default("General")
  accessToken          String                  @unique
  currentQuestionIndex Int                     @default(1)
  isFinalized          Boolean                 @default(false)
  rawScore             Decimal                 @db.Decimal(5, 2) @default(0.00)
  trackTitle           String                  @default("")
  questions            SessionQuestion[]
  telemetry            PassiveInteractionLog[]
  certificate          Certificate?
  createdAt            DateTime                @default(now())
  startedAt            DateTime?
  finalizedAt          DateTime?

  @@index([accessToken])
  @@index([orgId])
  @@map("candidate_sessions")
  @@schema("pc")
}

model SessionQuestion {
  id            String           @id @default(cuid())
  sessionId     String
  session       CandidateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ordinal       Int
  block         Int              @default(1) // block of 10 (1..10)
  scenario      String           // situational scenario text
  options       Json             // [{key,label}]
  correctKey    String           @default("")
  competency    String           @default("General")
  riskFactor    String           @default("")
  answerKey     String?
  isCorrect     Boolean          @default(false)
  answeredAt    DateTime?

  @@index([sessionId])
  @@map("session_questions")
  @@schema("pc")
}

model PassiveInteractionLog {
  id                        String           @id @default(cuid())
  sessionId                 String
  session                   CandidateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionNumber            Int
  timeToFirstClickMs        Int              @default(0)
  totalDwellTimeMs          Int              @default(0)
  toggleCount               Int              @default(0)
  readingCadenceCharsPerSec Decimal?         @db.Decimal(6, 2)
  erraticCursorSpam         Boolean          @default(false)
  viewportFocusLossCounter  Int              @default(0)
  purged                    Boolean          @default(false) // GDPR: raw purged after 24h
  capturedAt                DateTime         @default(now())

  @@index([sessionId])
  @@index([capturedAt])
  @@map("passive_interaction_logs")
  @@schema("pc")
}

model CorporateTalentReport {
  id                          String        @id @default(cuid())
  orgId                       String
  org                         EnterpriseOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  departmentKey               String
  aggregateCompetenceAvg      Decimal?      @db.Decimal(5, 2)
  projectedProductivityLossPct Decimal?     @db.Decimal(4, 2)
  burnoutRiskIndicator        String        @default("LOW")
  behavioralArchetype         String        @default("")
  skillGaps                   Json?
  compiledAt                  DateTime      @default(now())

  @@index([orgId])
  @@map("corporate_talent_reports")
  @@schema("pc")
}

model Certificate {
  id             String           @id @default(cuid())
  sessionId      String           @unique
  session        CandidateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidateName  String
  trackTitle     String
  finalGrade     Decimal          @db.Decimal(5, 2)
  confirmationStamp String        @unique // Base-62
  ledgerHash     String           @unique // idempotent guard
  issuedAt       DateTime         @default(now())

  @@index([confirmationStamp])
  @@map("certificates")
  @@schema("pc")
}

model TrainingRequest {
  id            String   @id @default(cuid())
  orgId         String
  departmentKey String   @default("")
  requestedBy   String
  skillGapData  Json
  status        String   @default("submitted") // submitted | in_review | fulfilled
  createdAt     DateTime @default(now())

  @@index([orgId])
  @@map("training_requests")
  @@schema("pc")
}

// ════════════════════════════════════════════════════════════════════════════
// CANDIDATE ASSESSMENT & ENGINEERING SIMULATOR (Enhancement PRS)
// Individual assessment journey — adaptive IRT engine, academic tracks, sandbox.
// ════════════════════════════════════════════════════════════════════════════

model SimBank {
  id          String   @id @default(cuid())
  kind        String   // NUMERICAL | VERBAL | OCEAN | SJT | ACADEMIC | ENGINEERING
  track       String   @default("GENERAL") // UK_GCSE | UK_ALEVEL | ZM_ECZ | GENERAL
  subject     String   @default("")        // e.g. Mathematics, Physics, Biology
  prompt      String
  passage     String   @default("")
  diagramData Json?
  options     Json                          // [{key,label}] or Likert / most-least sets
  correctKey  String   @default("")         // for scored items
  leastKey    String   @default("")         // SJT least-effective
  trait       String   @default("")         // OCEAN dimension or SDS
  reverse     Boolean  @default(false)      // reverse-scored Likert
  difficulty  Float    @default(0.0)        // IRT b-parameter (theta scale)
  discrimination Float @default(1.0)        // IRT a-parameter
  explanation String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([kind, track, subject])
  @@map("sim_bank")
  @@schema("pc")
}

model SimSession {
  id           String   @id @default(cuid())
  userId       String?
  classId      String?
  studentName  String   @default("")
  candidateToken String @unique
  kind         String
  track        String   @default("GENERAL")
  subject      String   @default("")
  theta        Float    @default(0.0)       // adaptive ability estimate
  answered     Int      @default(0)
  correct      Int      @default(0)
  responses    Json?                        // [{itemId, key, correct, ms, theta}]
  oceanScores  Json?                        // {O,C,E,A,N, sds}
  finalScore   Float?
  state        Json?                        // serialized layout for interruption recovery
  isFinalized  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([candidateToken])
  @@map("sim_sessions")
  @@schema("pc")
}

model SandboxSubmission {
  id           String   @id @default(cuid())
  userId       String?
  challengeId  String
  code         String   @default("")
  circuit      Json?                          // {components:[], wires:[]}
  astScore     Float    @default(0)
  circuitScore Float    @default(0)
  unitScore    Float    @default(0)
  totalScore   Float    @default(0)
  passed       Boolean  @default(false)
  hintsUsed    Int      @default(0)
  feedback     Json?
  createdAt    DateTime @default(now())

  @@index([challengeId])
  @@map("sandbox_submissions")
  @@schema("pc")
}

// Teacher automation suite (FE-07): classes, membership, auto-aggregated gaps.
model TeacherClass {
  id         String   @id @default(cuid())
  teacherId  String
  name       String
  track      String   @default("ZM_ECZ")
  subject    String   @default("")
  joinCode   String   @unique
  createdAt  DateTime @default(now())

  @@index([teacherId])
  @@map("teacher_classes")
  @@schema("pc")
}
